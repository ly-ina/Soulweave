{
  "name": "@ly-ina/dsh-soulweave",
  "version": "0.4.4",
  "private": false,
  "type": "module",
  "description": "Soulweave: a small soul layer for DeepSeek Harness. Injects a token-budgeted persona/now/how-to-look-up preamble via agent/pre-step, and exposes soul_recall over an optional memory backend (builtin SQLite / meow-memory / none) plus notes, sealed segments, an optional text index and an optional rules directory. Read-only towards soul.md; only soul_persist appends to its fourth section.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "soul",
    "persona",
    "memory",
    "context"
  ],
  "license": "MIT",
  "author": "ly-ina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ly-ina/Soulweave.git"
  },
  "homepage": "https://github.com/ly-ina/Soulweave#readme",
  "bugs": {
    "url": "https://github.com/ly-ina/Soulweave/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core/index.mjs",
    "./memory": "./memory/index.mjs",
    "./client": "./panel-client.js"
  },
  "files": [
    "index.js",
    "panel-client.js",
    "core/",
    "memory/",
    "adapters/",
    "tools/",
    "cordis.patch.yml",
    "REPORT.md",
    "README.md"
  ],
  "scripts": {
    "check": "node check.mjs",
    "clean-install": "node clean-install.mjs",
    "check-layers": "node tools/check-layers.mjs",
    "example": "node examples/node-cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22.5"
  }
}
