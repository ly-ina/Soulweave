{
  "name": "@ly-ina/dsh-soulweave",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "Soulweave: a small soul layer for DeepSeek Harness. Injects a token-budgeted persona/now/how-to-look-up preamble via agent/pre-step, and exposes soul_recall over an optional memory backend (builtin SQLite / meow-memory / none) plus notes, sealed segments and an optional text index. Read-only towards soul.md; only soul_persist appends to its fourth section.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "soul",
    "persona",
    "memory",
    "context"
  ],
  "license": "MIT",
  "author": "ly-ina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ly-ina/Soulweave.git"
  },
  "homepage": "https://github.com/ly-ina/Soulweave#readme",
  "bugs": {
    "url": "https://github.com/ly-ina/Soulweave/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "memory-builtin.mjs",
    "hybrid.mjs",
    "zones.mjs",
    "cue.mjs",
    "tier.mjs",
    "toolout.mjs",
    "surface.mjs",
    "capabilities.mjs",
    "gamedev.mjs",
    "soul_lint.mjs",
    "scripts/migrate-zones.mjs",
    "cordis.patch.yml",
    "soul.example.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node check.mjs",
    "clean-install": "node clean-install.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.5"
  }
}
